# ==============================================================================
# NISSAN AUTOMOTIVE PARTS CATALOG - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase PostgreSQL Database (Optional - Seamless Fallback to Demo Data)
# To connect your live Supabase project:
# 1. Create a project at https://supabase.com
# 2. Run supabase/migrations/20240922000000_init_schema.sql in the Supabase SQL Editor
# 3. Add your Project URL and Anon Key below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Dealership Admin Security Passcode (Optional - Default: nissan2024)
ADMIN_PASSCODE=nissan2024

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=https://nissan-parts-finder.vercel.app
